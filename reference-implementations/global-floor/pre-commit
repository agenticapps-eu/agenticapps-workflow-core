#!/usr/bin/env bash
# pre-commit — the machine-level enforcement floor (spec §18).
#
# global-floor-version: 1.0.0
#
# VERSION MARKER — read by the installer before writing this file to the
# published hooks directory. Installers MUST refuse to overwrite a higher
# version (treat an unmarked file as 0.0.0). Bump whenever behaviour changes.
#
# Published once per machine and bound with `git config --global core.hooksPath`.
# One file governs every enrolled repository, so there is one copy to upgrade
# rather than one per repository silently forking from the others.
#
# HOW THIS DIFFERS FROM THE PER-REPOSITORY HOOK, AND WHY IT MUST
#
# reference-implementations/openspec-change-gate/pre-commit resolves its gate as
#
#   [ -x "$GATE" ] || GATE="$(git rev-parse --show-toplevel)/bin/openspec-change-gate.sh"
#
# a fallback into the repository being committed to. That is reasonable for a
# hook a repository installs for itself: the repository already trusts its own
# contents. It is forbidden here. A global hook that falls back to
# repository-controlled code makes every clone on the machine able to supply the
# executable that runs at commit time — which is the property `core.hooksPath`
# exists to remove. Cloning a repository must never be enough to run code.
#
# Nothing below resolves anything from inside a repository.
set -uo pipefail

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HOOKS_D="$SELF_DIR/hooks.d"

say() { printf 'global-floor: %s\n' "$*" >&2; }

# ── Enrolment ──────────────────────────────────────────────────────────────
# A global binding runs this file in EVERY repository on the machine, including
# every repository that never opted into this workflow. So the first question is
# not "is this commit valid" but "is this repository ours".
#
# Measured before it was specified: with no predicate, a repository containing
# any `openspec/` tree that fails `openspec validate --all` had every commit
# blocked — a test fixture, a vendored example, an abandoned experiment — while
# a repository with no `openspec/` at all committed normally. The failure landed
# precisely on repositories that touched OpenSpec once and never adopted this.
#
# Enrolment is an ACT, not an inference from the shape of a directory. A
# predicate that guesses from shape makes the wrong outcome rarer without making
# it impossible, and its failures are silent for the person hit by them.
#
# Silent on the way out, deliberately: this hook runs in unrelated repositories
# all day and has nothing to say to them.
git config --get agenticapps.workflow.enrolled >/dev/null 2>&1 || exit 0

# ── hooks.d ownership ──────────────────────────────────────────────────────
# Checked BEFORE any entry runs, and about the DIRECTORY rather than its
# entries. Validating only the entries does not make the directory
# operator-owned: repointing `hooks.d` redirects every entry at once, so a
# per-entry check would inspect files that are no longer the ones about to run.
if [ -L "$HOOKS_D" ]; then
  say "REFUSED — $HOOKS_D is a symlink. Composition entries must live in a"
  say "directory you own; a symlink redirects all of them at once."
  exit 1
fi

if [ -d "$HOOKS_D" ]; then
  if [ ! -O "$HOOKS_D" ]; then
    say "REFUSED — $HOOKS_D is not owned by you."
    exit 1
  fi
  # Group- or world-writable means another local account can drop in code that
  # runs on every commit you make. `find -perm` rather than `stat`, whose
  # format flags differ between macOS and GNU.
  if [ -n "$(find "$HOOKS_D" -maxdepth 0 \( -perm -g+w -o -perm -o+w \) 2>/dev/null)" ]; then
    say "REFUSED — $HOOKS_D is group- or world-writable, so another local"
    say "user could install code that runs on every commit. chmod 755 it."
    exit 1
  fi
fi

# ── The gate ───────────────────────────────────────────────────────────────
# OPENSPEC_CHANGE_GATE is accepted as an alias for OPENSPEC_GATE: the pi host
# shipped that name first and its extension already resolves the gate through
# it. Honouring both means pi vendors nothing and carries no divergence.
#
# There is no third fallback. See the header: the missing branch is the point.
GATE="${OPENSPEC_GATE:-${OPENSPEC_CHANGE_GATE:-$HOME/.agenticapps/bin/openspec-change-gate.sh}}"

if [ -x "$GATE" ]; then
  "$GATE" --pre-commit
  rc=$?
  # Propagated verbatim rather than collapsed to 1. The gate distinguishes its
  # own failure modes by status, and a dispatcher that flattens them throws away
  # the only machine-readable thing it produces.
  [ "$rc" -eq 0 ] || exit "$rc"
else
  # Fail OPEN on absent tooling, consistent with §18: a commit hook that
  # hard-fails because a tool is missing trains people to pass --no-verify,
  # which disables the floor permanently rather than momentarily.
  say "WARNING — gate not found at $GATE; commit not gated."
fi

# ── Composition ────────────────────────────────────────────────────────────
# The operator's own machine-level hooks, run after the gate. Two reviewers
# disagreed about how this should compose: one asked that it exec the
# repository's original .git/hooks/, the other objected that doing so re-enables
# execution of repository-controlled code. Both were right about their own half,
# and this is the resolution — composition for the operator, who is the party
# that actually wanted it, without making a clone's contents executable.
#
# A repository that needs its own hooks has git's local `core.hooksPath`, which
# is the supported answer and costs nothing to support.
if [ -d "$HOOKS_D" ]; then
  for entry in "$HOOKS_D"/*; do
    # Debris — READMEs, .disabled files, directories, a non-executable draft —
    # is skipped rather than run. `-f` and `-x` together, so a directory whose
    # bit happens to be set is not executed.
    [ -f "$entry" ] && [ -x "$entry" ] || continue
    "$entry"
    rc=$?
    if [ "$rc" -ne 0 ]; then
      say "$entry exited $rc — commit stopped."
      # Stop rather than continue. A later entry running after an earlier one
      # refused would act on state the refusal was meant to prevent.
      exit "$rc"
    fi
  done
fi

exit 0
